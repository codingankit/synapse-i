# -------------------------------
# Application Environment
# -------------------------------

# Note: Next.js automatically sets NODE_ENV based on `next dev` (development) or `next build` (production). Do not set NODE_ENV in this file manually.

# Server port
PORT=3000


# -------------------------------
# Database (Supabase)
# ------------------------------- 

# Supabase project URL
SUPABASE_URL="https://your-project.supabase.co"

# Service role key (Keep secret, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Vector memory table name
SUPABASE_TABLE="synapse_memory"


# -------------------------------
# AI Provider Keys
# -------------------------------

# Voyage AI API key
VOYAGE_API_KEY="pa_your_voyage_api_key_here"

# Google AI (Gemini) API key
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy_your_google_api_key_here"

# LlamaCloud API key
LLAMA_CLOUD_API_KEY="llx_your_llama_cloud_key_here"


# -------------------------------
# Model Selection (optional — falls back to these defaults if unset)
# -------------------------------

# Gemini models for extraction and auditing
GEMINI_EXTRACTION_MODEL="gemini-3.5-flash"
GEMINI_AUDIT_MODEL="gemini-3.5-flash"

# Voyage models for embeddings and re-ranking
VOYAGE_EMBEDDING_MODEL="voyage-4-lite"
VOYAGE_RERANKING_MODEL="rerank-2.5-lite"