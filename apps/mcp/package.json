{
  "name": "@synapse/mcp",
  "version": "1.0.0",
  "main": "./dist/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "rimraf dist .tsbuildinfo",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "pnpm clean && pnpm typecheck && tsup",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "inspector": "pnpm dlx -y @modelcontextprotocol/inspector",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.1",
    "@hono/node-server": "^2.0.11",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@synapse/core": "workspace:*",
    "hono": "^4.12.31",
    "zod": "^4.4.3"
  }
}
